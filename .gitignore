*.key

# Model checkpoints & large weights (NEVER commit weights)
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Training data & cached datasets (NEVER commit raw or tokenized datasets)
data/*
!data/.gitkeep
data_cache/
*.arrow
*.parquet
*.jsonl.gz

# Logs & run artifacts
logs/*
!logs/.gitkeep
wandb/
runs/
*.tfevents.*

# Tokenizer models (keep only small sample/smoke tokenizers if committed)
tokenizer_cache/*
!tokenizer_cache/smoke/
!tokenizer_cache/smoke/**

# SUSA AURA local runtime state & memory
.aura/
