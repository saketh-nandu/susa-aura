# ==============================================================================
# SUSA-1B CodeMind — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local adjustments:
#   cp .env.example .env
#
# DO NOT commit .env containing secret tokens or credentials to Git!
# ==============================================================================

# Project & Runtime Environment
PROJECT_NAME=susa-1b-codemind
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED=42

# Local Paths
DATA_DIR=./data
CHECKPOINT_DIR=./checkpoints
LOG_DIR=./logs

# Training Hardware Constraints (Local Laptop Safety Limits)
MAX_LOCAL_RAM_GB=6.0
FORCE_CPU=1

# Optional Weights & Biases Logging (Colab/Cloud runs only)
# WANDB_API_KEY=
# WANDB_PROJECT=susa-1b-codemind
# WANDB_ENTITY=
