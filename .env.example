# ==============================================================================
# SUSA AURA — Adaptive Universal Reasoning Assistant
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local adjustments:
#   cp .env.example .env
#
# DO NOT commit .env containing secret tokens or credentials to Git!
# ==============================================================================

# Project & Runtime Environment
AURA_PROJECT_NAME=susa-aura
AURA_ENVIRONMENT=development
AURA_LOG_LEVEL=INFO
AURA_SEED=42

# Local Paths
AURA_DATA_DIR=./data
AURA_CHECKPOINT_DIR=./checkpoints
AURA_LOG_DIR=./logs

# Training Hardware Constraints (Local Laptop Safety Limits)
AURA_MAX_LOCAL_RAM_GB=6.0
AURA_FORCE_CPU=1

# AURA Connect & Research Subsystem (Optional online search)
AURA_CONNECT_ENABLE=1
# AURA_SEARCH_API_KEY=

# Optional Weights & Biases Logging (Colab/Cloud runs only)
# WANDB_API_KEY=
# WANDB_PROJECT=susa-aura
# WANDB_ENTITY=

# ==============================================================================
# Legacy Aliases (Supported for backward compatibility)
# ==============================================================================
# PROJECT_NAME=susa-aura
# DATA_DIR=./data
# CHECKPOINT_DIR=./checkpoints
# LOG_DIR=./logs
